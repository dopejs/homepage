---
import CommandBlock from './CommandBlock.astro';
import { useTranslations, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { Project } from '../data/projects';
import { statusTone, statusKey } from '../lib/status';

interface Props {
  lang: Lang;
  project: Project;
  index: number;
}

const { lang, project, index } = Astro.props;
const t = useTranslations(lang);

const href = localePath(lang, `/projects/${project.slug}/`);
const primaryInstall = project.installs?.[0];
---

<article
  id={project.slug}
  class="group relative scroll-mt-24 rounded-xl border border-line bg-surface/60 p-6 transition-colors hover:border-accent/30 hover:bg-surface-2/60 sm:p-8"
>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <span class="font-mono text-xs text-muted/70">{String(index + 1).padStart(2, '0')}</span>
    <h3 class="font-mono text-xl font-semibold tracking-tight">
      <!-- Stretched link: the whole card is the target, inner links stay clickable via z-10. -->
      <a href={href} class="after:absolute after:inset-0 hover:text-accent">{project.name}</a>
    </h3>
    <span class={`rounded-full border px-2.5 py-0.5 font-mono text-[11px] ${statusTone[project.status]}`}>
      {t(statusKey(project.status))}
    </span>
  </div>

  <p class="mt-4 text-lg text-fg/90">{project.tagline[lang]}</p>
  <p class="mt-3 max-w-3xl leading-relaxed text-muted">{project.summary[lang]}</p>

  {
    primaryInstall && (
      <div class="relative z-10 mt-5">
        <CommandBlock lang={lang} command={primaryInstall.command} />
      </div>
    )
  }

  <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
    <div class="flex flex-wrap gap-2">
      {
        project.languages.map((l) => (
          <span class="rounded border border-line px-2 py-0.5 font-mono text-[11px] text-muted">{l}</span>
        ))
      }
      {
        project.license && (
          <span class="rounded border border-line px-2 py-0.5 font-mono text-[11px] text-muted">
            {project.license}
          </span>
        )
      }
    </div>

    <div class="relative z-10 ml-auto flex items-center gap-4">
      <a
        href={project.repo}
        rel="noopener noreferrer"
        target="_blank"
        class="text-muted transition-colors hover:text-accent">{t('projects.repo')} ↗</a
      >
      <a href={href} class="text-accent hover:underline">{t('projects.details')} →</a>
    </div>
  </div>
</article>
