---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/config';
import { ORG_URL, SITE_REPO_URL } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line/70 py-10">
  <div class="wrap flex flex-col gap-4 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="font-mono">© {year} {t('footer.rights')}</p>
    <div class="flex flex-col gap-1 sm:items-end">
      <p>
        <a href={SITE_REPO_URL} rel="noopener noreferrer" target="_blank" class="hover:text-fg">
          {t('footer.built')}
        </a>
        <span class="px-2 text-line" aria-hidden="true">·</span>
        <a href={ORG_URL} rel="noopener noreferrer" target="_blank" class="hover:text-fg">github.com/dopejs</a>
      </p>
      <p class="text-xs text-muted/70">{t('footer.translations')}</p>
    </div>
  </div>
</footer>
