---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Rendered size in px. */
  size?: number;
}

const { project, size = 32 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{
  /* Projects that ship a mark use it; the rest get a monogram tile in the site
     accent, so a card row stays aligned without inventing a brand for them. */
  project.logo ? (
    <img
      src={`${base}/logos/${project.logo}`}
      alt=""
      aria-hidden="true"
      width={size}
      height={size}
      class="shrink-0 rounded-[7px] object-contain"
      style={`width:${size}px;height:${size}px`}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span
      aria-hidden="true"
      class="grid shrink-0 place-items-center rounded-[7px] bg-accent/90 font-mono font-bold text-ink"
      style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.5)}px`}
    >
      {project.name.charAt(0).toUpperCase()}
    </span>
  )
}
