---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  command: string;
  label?: string;
}

const { lang, command, label } = Astro.props;
const t = useTranslations(lang);
---

<div class="min-w-0">
  {label && <p class="mono-label mb-2">{label}</p>}
  <div class="flex items-stretch gap-2">
    <code
      class="min-w-0 flex-1 overflow-x-auto rounded-lg border border-line bg-ink/70 px-3 py-2 font-mono text-xs leading-6 whitespace-nowrap text-fg/80"
      >{command}</code
    >
    <button
      type="button"
      class="shrink-0 rounded-lg border border-line px-3 font-mono text-xs text-muted transition-colors hover:border-accent/60 hover:text-accent"
      data-copy={command}
      data-copy-label={t('projects.copy')}
      data-copied-label={t('projects.copied')}
    >
      {t('projects.copy')}
    </button>
  </div>
</div>

<script>
  // Progressive enhancement: without JS the command is still selectable text.
  // Astro hoists and dedupes this module, so one listener set covers every block.
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.dataset.copy ?? '';
      const copied = button.dataset.copiedLabel ?? 'Copied';
      const label = button.dataset.copyLabel ?? 'Copy';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return; // Clipboard blocked (insecure context or denied permission) — leave the label alone.
      }
      button.textContent = copied;
      window.setTimeout(() => {
        button.textContent = label;
      }, 1600);
    });
  });
</script>
