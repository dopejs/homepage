---
import LanguageMenu from './LanguageMenu.astro';
import { useTranslations, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/config';
import { ORG_URL } from '../data/site';

interface Props {
  lang: Lang;
  /** Current locale-independent route, so the language menu stays on this page. */
  path?: string;
}

const { lang, path = '/' } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, '/');
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-ink/80 backdrop-blur">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href={home} class="group flex shrink-0 items-center gap-2.5">
      <span
        class="grid size-7 place-items-center rounded-[6px] bg-accent font-mono text-sm font-bold text-ink"
        aria-hidden="true">d</span
      >
      <span class="font-mono text-base font-semibold tracking-tight">dopejs</span>
    </a>

    <nav class="flex items-center gap-1 text-sm" aria-label="Primary">
      <!-- The in-page links are hidden on narrow screens: the sections they point at
           are the whole page, and keeping them overflows a 390px viewport. -->
      <a href={`${home}#projects`} class="hidden rounded px-3 py-2 text-muted transition-colors hover:text-fg sm:inline-block"
        >{t('nav.projects')}</a
      >
      <a href={`${home}#about`} class="hidden rounded px-3 py-2 text-muted transition-colors hover:text-fg sm:inline-block"
        >{t('nav.about')}</a
      >
      <a
        href={ORG_URL}
        rel="noopener noreferrer"
        target="_blank"
        class="rounded px-2 py-2 text-muted transition-colors hover:text-fg sm:px-3">{t('nav.github')}</a
      >
      <div class="ms-1 sm:ms-2">
        <LanguageMenu lang={lang} path={path} />
      </div>
    </nav>
  </div>
</header>
