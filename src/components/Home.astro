---
import ProjectCard from './ProjectCard.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { projects } from '../data/projects';
import { ORG_URL } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Monospace flatters Latin display type but spaces CJK glyphs badly, so Chinese
// headings and buttons fall back to the sans stack.
const display = lang === 'zh' ? 'font-sans' : 'font-mono';
---

<section class="wrap pt-20 pb-16 sm:pt-28 sm:pb-24">
  <p class="mono-label">{t('hero.eyebrow')}</p>
  <h1 class:list={['mt-5 max-w-3xl text-4xl leading-[1.1] font-semibold tracking-tight sm:text-6xl', display]}>
    {t('hero.title')}
  </h1>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{t('hero.body')}</p>

  <div class="mt-9 flex flex-wrap items-center gap-3">
    <a
      href="#projects"
      class:list={[
        'rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-ink transition-opacity hover:opacity-90',
        display,
      ]}
      >{t('hero.cta.projects')}</a
    >
    <a
      href={ORG_URL}
      rel="noopener noreferrer"
      target="_blank"
      class:list={[
        'rounded-lg border border-line px-5 py-2.5 text-sm text-fg transition-colors hover:border-accent/60 hover:text-accent',
        display,
      ]}
      >{t('hero.cta.github')} ↗</a
    >
    <span class="ml-1 font-mono text-sm text-muted/80">{projects.length} {t('hero.count')}</span>
  </div>
</section>

<section id="projects" class="wrap scroll-mt-20">
  <div class="border-t border-line/70 pt-12">
    <h2 class:list={['text-2xl font-semibold tracking-tight sm:text-3xl', display]}>{t('projects.title')}</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted">{t('projects.lead')}</p>
  </div>

  <!-- grid-cols-1 (not bare `grid`) so the implicit column is minmax(0,1fr):
       otherwise the nowrap install command widens every card past the viewport. -->
  <div class="mt-10 grid grid-cols-1 gap-5">
    {projects.map((project, index) => <ProjectCard lang={lang} project={project} index={index} />)}
  </div>
</section>

<section id="about" class="wrap mt-24 scroll-mt-20">
  <div class="rounded-xl border border-line bg-surface/60 p-8 sm:p-12">
    <h2 class:list={['text-2xl font-semibold tracking-tight', display]}>{t('about.title')}</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted">{t('about.body')}</p>
    <a
      href={ORG_URL}
      rel="noopener noreferrer"
      target="_blank"
      class:list={['mt-6 inline-block text-sm text-accent hover:underline', display]}
      >{t('about.cta')} ↗</a
    >
  </div>
</section>
