---
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { projects } from '../../data/projects';
import { buildProjectPaths } from '../../lib/project-paths';
import { defaultLang } from '../../i18n/config';
import { projectCopy } from '../../i18n/utils';

export function getStaticPaths() {
  return buildProjectPaths(projects);
}

const lang = defaultLang;
const { project, prev, next } = Astro.props;
---

<Base
  lang={lang}
  path={`/projects/${project.slug}/`}
  title={`${project.name} — dopejs`}
  description={projectCopy(lang, project.slug).tagline}
>
  <ProjectDetail lang={lang} project={project} prev={prev} next={next} />
</Base>
