---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import { locales, defaultLang, type Lang } from '../../i18n/config';

/** Every locale except the default one, which is served from the site root. */
export function getStaticPaths() {
  return locales
    .filter((locale) => locale.code !== defaultLang)
    .map((locale) => ({ params: { lang: locale.code }, props: { lang: locale.code as Lang } }));
}

const { lang } = Astro.props;
---

<Base lang={lang}>
  <Home lang={lang} />
</Base>
